# Required to boot the bot (npm run dev / start / register)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands to one guild (instant) instead of globally (slow to propagate)
DISCORD_GUILD_ID=
# Messages that START with one of these names get an AI reply ("mustardbot what counters Puck?").
# Needs "Message Content Intent" enabled under Developer Portal -> Bot -> Privileged Gateway Intents.
# Comma-separated; set to empty to disable (then only @mentions work). Default: mustardbot
# BOT_TRIGGER_NAMES=mustardbot

# Optional
OPENDOTA_API_KEY=
# Override for testing the "provider unavailable" path
# OPENDOTA_BASE_URL=https://api.opendota.com/api
LOG_LEVEL=info

# AI explanations + /ask + @mentions. Without a key the bot still works and shows data-only answers.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_REASONING_EFFORT=low     # none | minimal | low | medium | high (gpt-5*/o* models only)
# AI_TIMEOUT_MS=25000

# Web search for questions our data can't answer (other games, Dota patch notes/news/tournaments).
# Uses OpenAI's web_search tool: extra cost per search, answers list their sources. Set to false to disable.
# WEB_SEARCH_ENABLED=true
# WEB_SEARCH_MODEL=gpt-5.4-mini
# WEB_SEARCH_TIMEOUT_MS=45000

# Short-term conversation memory, shared by everyone in a channel (in-process; cleared on restart).
# "mustardbot forget" or /forget clears it. MEMORY_MAX_TURNS=0 disables memory.
# MEMORY_MAX_TURNS=6
# MEMORY_TTL_MINUTES=30

# Later phases
# ANTHROPIC_API_KEY=
# STRATZ_API_TOKEN=
# REDIS_URL=
# DATABASE_URL=
